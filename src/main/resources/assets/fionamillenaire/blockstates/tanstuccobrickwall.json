{
"multipart": [
{ "when": { "up": "true" }, "apply": { "model": "fionamillenaire:block/tanstuccobrickwall_post" } },
{ "when": { "north": "low" },  "apply": { "model": "fionamillenaire:block/tanstuccobrickwall_side", "uvlock": true } },
{ "when": { "east": "low" },   "apply": { "model": "fionamillenaire:block/tanstuccobrickwall_side", "y": 90, "uvlock": true } },
{ "when": { "south": "low" },  "apply": { "model": "fionamillenaire:block/tanstuccobrickwall_side", "y": 180, "uvlock": true } },
{ "when": { "west": "low" },   "apply": { "model": "fionamillenaire:block/tanstuccobrickwall_side", "y": 270, "uvlock": true } },
{ "when": { "north": "tall" }, "apply": { "model": "fionamillenaire:block/tanstuccobrickwall_side_tall", "uvlock": true } },
{ "when": { "east": "tall" },  "apply": { "model": "fionamillenaire:block/tanstuccobrickwall_side_tall", "y": 90, "uvlock": true } },
{ "when": { "south": "tall" }, "apply": { "model": "fionamillenaire:block/tanstuccobrickwall_side_tall", "y": 180, "uvlock": true } },
{ "when": { "west": "tall" },  "apply": { "model": "fionamillenaire:block/tanstuccobrickwall_side_tall", "y": 270, "uvlock": true } }
]
}